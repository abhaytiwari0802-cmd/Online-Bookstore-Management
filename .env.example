# ============================================================================
# ONLINE BOOKSTORE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================

# Web Server Port
PORT=3000

# Set to true to connect to a live Oracle Database instance (e.g. Oracle 19c/21c/23c/XE)
# Set to false to use the built-in zero-setup PL/SQL database engine
USE_ORACLE=false

# Oracle Database Credentials
DB_USER=bookstore_user
DB_PASSWORD=your_oracle_password
DB_CONNECT_STRING=localhost:1521/XEPDB1
